      "regex": "^/services/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/services/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/work/[slug]",
